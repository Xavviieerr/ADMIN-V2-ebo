# GitHub Gist – Guidelines (optional)
# Required only if you want to save edits from the app to the gist.
# Get the raw URL from your gist: Gist → Raw → copy URL.
# Create a PAT at: GitHub → Settings → Developer settings → Personal access tokens (scope: gist).

# Raw URL for reading guidelines (defaults to guonodev/ef31d9c486319fc61b4f8a3e721ee442 if unset)
# GITHUB_GIST_RAW_URL=https://gist.githubusercontent.com/guonodev/ef31d9c486319fc61b4f8a3e721ee442/raw/guidelines.json

# Gist ID (defaults to the above gist if unset)
# GITHUB_GIST_ID=ef31d9c486319fc61b4f8a3e721ee442

# Personal access token with gist scope – add this to .env.local only, never commit
# GITHUB_GIST_TOKEN=ghp_xxxx
